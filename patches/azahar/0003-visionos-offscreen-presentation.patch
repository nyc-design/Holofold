+// Copyright 2026 Bifold contributors
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+// Offscreen presentation (Apple Vision Pro). Instead of presenting to the swapchain, the Vulkan
+// present thread copies every finished frame into one of a small ring of images whose Metal
+// textures the frontend can read (here: blitted into a RealityKit LowLevelTexture). Header-only so
+// the renderer and the frontend layer share one copy of the state without new build sources.
+//
+// Protocol: the presenter writes into a ring slot that is neither the newest published frame nor
+// the slot the frontend holds, waits for the copy to finish, then publishes it. The frontend
+// Acquire()s the newest slot (blocking reuse of exactly that slot), reads it on the GPU and
+// Release()s it once its command buffer completed.
+
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+
+namespace VideoCore::Offscreen {
+
+constexpr int kRingSize = 3;
+
+struct State {
+    /// Set by the frontend before the renderer starts; read once by the presenter.
+    std::atomic_bool requested{false};
+
+    std::mutex mutex;
+    /// Unretained id<MTLTexture> of each ring image (owned by the Vulkan images).
+    std::array<void*, kRingSize> textures{};
+    uint32_t width = 0;
+    uint32_t height = 0;
+    /// Incremented whenever the ring is recreated (size change), so the frontend rebuilds.
+    uint64_t generation = 0;
+    int latest = -1;   ///< newest published slot
+    int in_use = -1;   ///< slot the frontend currently reads
+    uint64_t frame = 0; ///< increments with every published frame
+};
+
+inline State& Get() {
+    static State state;
+    return state;
+}
+
+/// Presenter: next slot to write. Never the newest frame or the slot being read.
+inline int NextWriteSlot(int previous) {
+    auto& s = Get();
+    std::scoped_lock lock{s.mutex};
+    for (int i = 1; i <= kRingSize; ++i) {
+        const int slot = (previous + i) % kRingSize;
+        if (slot != s.latest && slot != s.in_use) {
+            return slot;
+        }
+    }
+    return (previous + 1) % kRingSize; // unreachable with three slots
+}
+
+/// Presenter: the copy into `slot` has completed on the GPU.
+inline void Publish(int slot) {
+    auto& s = Get();
+    std::scoped_lock lock{s.mutex};
+    s.latest = slot;
+    ++s.frame;
+}
+
+struct Acquired {
+    void* texture = nullptr;
+    int slot = -1;
+    uint64_t frame = 0;
+    uint64_t generation = 0;
+    uint32_t width = 0;
+    uint32_t height = 0;
+};
+
+/// Frontend: hold the newest frame. Returns slot -1 when nothing was published yet.
+inline Acquired Acquire() {
+    auto& s = Get();
+    std::scoped_lock lock{s.mutex};
+    Acquired out;
+    if (s.latest < 0 || s.in_use >= 0) {
+        return out;
+    }
+    s.in_use = s.latest;
+    out.slot = s.latest;
+    out.texture = s.textures[s.latest];
+    out.frame = s.frame;
+    out.generation = s.generation;
+    out.width = s.width;
+    out.height = s.height;
+    return out;
+}
+
+inline void Release(int slot) {
+    auto& s = Get();
+    std::scoped_lock lock{s.mutex};
+    if (s.in_use == slot) {
+        s.in_use = -1;
+    }
+}
+
+} // namespace VideoCore::Offscreen
