#usda 1.0
(
    customLayerData = {
        string comment = "Bifold: 3DS screen panel for Apple Vision Pro. Samples Texture at TexCoord * Scale + Offset, where Offset is LeftOffset for the left eye and RightOffset for the right eye (Camera Index Switch; mono views use the left one). Set Scale/Offsets from code to pick a screen rect out of the side-by-side stereo frame."
    }
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    def Material "StereoScreen"
    {
        asset inputs:Texture
        float2 inputs:Scale = (1, 1)
        float2 inputs:LeftOffset = (0, 0)
        float2 inputs:RightOffset = (0, 0)
        token outputs:mtlx:surface.connect = </Root/StereoScreen/Unlit.outputs:out>
        token outputs:realitykit:vertex

        def Shader "Unlit"
        {
            uniform token info:id = "ND_realitykit_unlit_surfaceshader"
            color3f inputs:color.connect = </Root/StereoScreen/Image.outputs:out>
            bool inputs:applyPostProcessToneMap = 0
            token outputs:out
        }

        def Shader "Image"
        {
            uniform token info:id = "ND_RealityKitTexture2D_color3"
            asset inputs:file.connect = </Root/StereoScreen.inputs:Texture>
            float2 inputs:texcoord.connect = </Root/StereoScreen/SampleUV.outputs:out>
            bool inputs:no_flip_v = 1
            string inputs:mag_filter = "linear"
            string inputs:min_filter = "linear"
            string inputs:mip_filter = "linear"
            color3f outputs:out
        }

        def Shader "SampleUV"
        {
            uniform token info:id = "ND_add_vector2"
            float2 inputs:in1.connect = </Root/StereoScreen/ScaledUV.outputs:out>
            float2 inputs:in2.connect = </Root/StereoScreen/EyeOffset.outputs:out>
            float2 outputs:out
        }

        def Shader "ScaledUV"
        {
            uniform token info:id = "ND_multiply_vector2"
            float2 inputs:in1.connect = </Root/StereoScreen/TexCoord.outputs:out>
            float2 inputs:in2.connect = </Root/StereoScreen.inputs:Scale>
            float2 outputs:out
        }

        def Shader "TexCoord"
        {
            uniform token info:id = "ND_texcoord_vector2"
            int inputs:index = 0
            float2 outputs:out
        }

        def Shader "EyeOffset"
        {
            uniform token info:id = "ND_realitykit_geometry_switch_cameraindex_vector2"
            float2 inputs:mono.connect = </Root/StereoScreen.inputs:LeftOffset>
            float2 inputs:left.connect = </Root/StereoScreen.inputs:LeftOffset>
            float2 inputs:right.connect = </Root/StereoScreen.inputs:RightOffset>
            float2 outputs:out
        }
    }
}
